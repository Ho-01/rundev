{
  "name": "rundev",
  "private": true,
  "version": "0.6.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-runner-ui-assets.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "version:check-tag": "node scripts/version.mjs tag",
    "coupon": "node scripts/coupon.mjs",
    "tray:frames": "node scripts/build-tray-animation.mjs",
    "icons:app": "node scripts/build-app-icon.mjs && tauri icon src-tauri/app-icon-source.png && node scripts/restore-macos-app-icon.mjs",
    "runners:ui": "node scripts/build-runner-ui-assets.mjs",
    "docs:assets": "node scripts/build-runner-ui-assets.mjs && node scripts/generate-readme-assets.mjs",
    "docs:assets:refresh": "npm run build && npm run docs:assets",
    "docs:assets:check": "npm run docs:assets && git diff --exit-code -- docs/assets/readme",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "matter-js": "^0.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.1.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "gifenc": "^1.0.3",
    "jsdom": "^25.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
